datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  name         String
  nickname     String?
  provider     String        @default("email") // email, google, apple
  providerId   String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  dataRecords  UserData[]
  sessions     UserSession[]
}

model UserData {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType  String   // workouts, meals, supplements, weight, health, settings
  payload   String   // JSON stringificado con los datos completos
  updatedAt DateTime @updatedAt

  @@unique([userId, dataType])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
